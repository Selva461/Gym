<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and below. Android 12+ ignores this file and reads
  data_extraction_rules.xml instead, which additionally refuses to upload anything
  when the device cannot encrypt the backup end to end. There is no equivalent of
  that condition here, so on API 26-30 the backup is only as private as the device's
  screen lock makes it. Set android:allowBackup="false" in the manifest if you would
  rather have no off-device copy at all.
-->
<full-backup-content>
    <!-- Room runs in WAL mode, so recent writes can still be sitting in the -wal file
         when a backup is taken. The -shm file is deliberately left out: SQLite rebuilds
         it from the -wal, and restoring a stale one is worse than restoring none. -->
    <include domain="database" path="gym.db" />
    <include domain="database" path="gym.db-wal" />
    <!-- Targets, rest length and the reminder live in DataStore, which writes under
         files/datastore — not sharedpref. Without this line a reinstall silently
         resets every setting. -->
    <include domain="file" path="datastore/" />
</full-backup-content>
